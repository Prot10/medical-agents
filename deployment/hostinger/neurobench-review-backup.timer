[Unit]
Description=Daily NeuroBench review annotations backup
Requires=neurobench-review-backup.service

[Timer]
# Daily at 03:15 UTC. Persistent=true so a missed run (host was off) fires
# at next boot, instead of silently skipping the day.
OnCalendar=*-*-* 03:15:00
Persistent=true
Unit=neurobench-review-backup.service

[Install]
WantedBy=timers.target
