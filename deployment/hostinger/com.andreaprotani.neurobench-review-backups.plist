<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Daily pull of the VPS review backups to the Mac (pull-review-backups.sh).
  __HOME__ is replaced by the install command in README.md, "Off-VPS copy".
  09:30 local time follows the 03:15 UTC snapshot; a run missed while the
  Mac slept fires on wake, and RunAtLoad covers a Mac that was off.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.andreaprotani.neurobench-review-backups</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__HOME__/Backups/neurobench-review-backups/pull-review-backups.sh</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>9</integer>
    <key>Minute</key>
    <integer>30</integer>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>StandardOutPath</key>
  <string>__HOME__/Backups/neurobench-review-backups/pull.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/Backups/neurobench-review-backups/pull.log</string>
</dict>
</plist>
