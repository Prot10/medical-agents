# Results
results/

# Training artefacts. Checkpoints and adapters are too large for git and live on EOS.
#
# The gold trajectories ARE tracked: they are the teacher output of an expensive
# distillation run (~62M Sonnet tokens) and cannot be cheaply regenerated, unlike the
# prompts, which `--prepare-prompts` rebuilds deterministically from the cases + splits.
training_data/*
!training_data/gold_trajectories/
training_data/gold_trajectories/*
!training_data/gold_trajectories/trajectories.jsonl
!training_data/gold_trajectories/manifest.json
!training_data/gold_trajectories/raw/
checkpoints/

# Personal scratch (screenshots, notes)
kubeflow/

# Review-app runtime data (per-reviewer annotations live on the file system,
# never in git — see CLAUDE.md)
data/review/annotations/
data/review/tool_reviews/

# Reviewer access codes are bearer secrets — never commit them.
# A redacted template lives at reviewer_codes.example.yaml.
agent-platform/config/review/reviewer_codes.yaml

# ChromaDB
chroma_data/

# OS
.DS_Store
Thumbs.db

# Copilot auth token (sensitive)
data/.copilot_token.json

# Kosmico workspace cache (latex build, vector db, project state)
.kosmico/

# LaTeX build artefacts
*.synctex.gz
*.aux
*.log
*.nav
*.out
*.toc
*.vrb
*.fls
*.fdb_latexmk

# Per-case generation prompts are rebuilt deterministically from
# dataset-generation/config/conditions.yaml + seeds/ (see build_prompt*.py)
dataset-generation/prompts/

# torch.compile cache written by unsloth-zoo
unsloth_compiled_cache/
