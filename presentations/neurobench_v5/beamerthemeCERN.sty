\setbeamercolor{author}{fg=CERNtextdark}
\setbeamercolor{date}{fg=CERNtextdark}
\setbeamercolor{institute}{fg=CERNtextdark}
\setbeamercolor{titlegraphic}{fg=CERNblue}

\setbeamercolor{frametitle}{fg=CERNblue,bg=CERNwhite}
\setbeamercolor{framesubtitle}{fg=CERNtextdark}

\setbeamercolor{section in toc}{fg=CERNblue}
\setbeamercolor{section in toc shaded}{fg=CERNtextdark}
\setbeamercolor{subsection in toc}{fg=CERNtextdark}
\setbeamercolor{subsection in toc shaded}{fg=CERNtextdark}
\setbeamercolor{section in head/foot}{fg=CERNblue,bg=CERNwhite}
\setbeamercolor{subsection in head/foot}{fg=CERNblue,bg=CERNwhite}

\setbeamercolor{footline}{fg=CERNblue,bg=CERNwhite}
