%%
%% beamerthemeCERN.sty -- CERN Beamer theme (single-file distribution)
%%
%% A LaTeX Beamer theme that replicates CERN's corporate PowerPoint template.
%%
%% Usage:
%%   \documentclass[aspectratio=169,t]{beamer}
%%   \usetheme{CERN}                         % default -- single CERN logo
%%
%%   % Enable a second (cobranding) logo on cover / footer / end slide
%%   % / section transitions:
%%   \usetheme[cobrand]{CERN}
%%   \cobrandinglogo{logos/my-brand.pdf}
%%
%%   \title{...}  \subtitle{...}  \author{...}  \date{...}
%%   \event{Conference name}                 % optional; shown in footer
%%   \begin{document}
%%     \maketitle
%%     \maketoc                              % optional outline slide
%%     \section{First section}               % auto blue transition slide
%%     \begin{frame}{Frame title}...\end{frame}
%%     \sectionslide{Explicit transition}    % manual transition slide
%%     \makeend                              % "home.cern" closing slide
%%   \end{document}
%%
%% Engines:
%%   XeLaTeX / LuaLaTeX  (recommended; uses fontspec + TeX Gyre Heros)
%%   pdfLaTeX            (falls back to helvet)
%%
%% File layout inside this single .sty
%%   1. Theme options                 \DeclareOptionBeamer
%%   2. Internal state                path/event/section macros + [cafein] preset
%%   3. Required packages             tikz / booktabs / natbib / fontspec etc.
%%   4. Colour palette                CERN semantic colours + Beamer colour slots
%%   5. Fonts                         fontspec or helvet + Beamer font slots
%%   6. Inner theme                   blocks / itemize / captions / tables
%%   7. Outer theme (helpers)         margin, section background, title box,
%%                                    footer text, logo row, timeline
%%   8. Outer theme (templates)       title page / frametitle / footline /
%%                                    section page / part page / end page /
%%                                    TOC / AtBeginSection hook
%%   9. Date format + hyperref
%%  10. User-facing macros
%%

\ProvidesPackage{beamerthemeCERN}[2026/04/22 v2.0 CERN Beamer theme]

%%=============================================================================
%% 1. Theme options
%%    [cobrand]    reserves a cobranding logo slot next to the CERN mark on
%%                 the cover, every content footer, the closing slide, and
%%                 the section transitions. Pair with \cobrandinglogo{path}
%%                 (and optionally \cobrandinglogowhite{path} for the white
%%                 variant used on blue section slides).
%%    [cafein]     pre-configured CAFEIN team variant. Equivalent to
%%                 [cobrand] + \cobrandinglogo{logos/cafein-logo.pdf}
%%                          + \cobrandinglogowhite{logos/cafein-logo-white.pdf}.
%%                 Also appends a cafein.web.cern.ch link to the closing slide.
%%    [authoryear] switch citations from numeric [1] to author-year, e.g.
%%                 "Protani et al. (2024)" (\citet) or
%%                 "(Protani et al., 2024)" (\citep / \cite). Default: numeric.
%%=============================================================================
\newif\ifbeamer@cern@cobrand
\beamer@cern@cobrandfalse
\DeclareOptionBeamer{cobrand}{\beamer@cern@cobrandtrue}

\newif\ifbeamer@cern@cafein
\beamer@cern@cafeinfalse
\DeclareOptionBeamer{cafein}{%
  \beamer@cern@cafeintrue
  \beamer@cern@cobrandtrue   % cafein implies cobrand
}

\newif\ifbeamer@cern@authoryear
\beamer@cern@authoryearfalse
\DeclareOptionBeamer{authoryear}{\beamer@cern@authoryeartrue}

\ProcessOptionsBeamer

\mode<presentation>

%%=============================================================================
%% 2. Internal state
%%=============================================================================
\let\beamer@cern@cobrandpath\@empty                        % set by \cobrandinglogo
\let\beamer@cern@cobrandpathwhite\@empty                   % set by \cobrandinglogowhite
\let\beamer@cern@event\@empty                              % set by \event
\let\beamer@cern@sectionlist\@empty                        % set by \cernsections
\def\beamer@cern@logopath{logos/cern-logo.pdf}             % \cernlogopath
\def\beamer@cern@logopathwhite{logos/cern-logo-white.pdf}  % \cernlogopathwhite

% [cafein] preset: wire in the CAFEIN logos (users can still override).
\ifbeamer@cern@cafein
  \def\beamer@cern@cobrandpath{logos/cafein-logo.pdf}
  \def\beamer@cern@cobrandpathwhite{logos/cafein-logo-white.pdf}
\fi

%%=============================================================================
%% 3. Required packages
%%=============================================================================
\RequirePackage{iftex}
\RequirePackage{tikz}
\usetikzlibrary{calc,positioning,arrows.meta}
\RequirePackage{graphicx}
\RequirePackage{booktabs}
\RequirePackage{colortbl}

% Citations via natbib; loaded here so it sees Beamer's \bibitem.
\ifbeamer@cern@authoryear
  \RequirePackage[authoryear,round]{natbib}
\else
  \RequirePackage[numbers,square]{natbib}
\fi

%%=============================================================================
%% 4. Colour palette
%%    Hex values taken from the CERN brand palette; the dk1/lt1/accent
%%    names in the comments below refer to the PowerPoint theme roles.
%%=============================================================================
% Primary brand
\definecolor{CERNblue}{HTML}{0033A0}   % dk1, accent1 -- the only "CERN blue"
% Secondary accents (PPTX accent2..6)
\definecolor{CERNcyan}{HTML}{61C4D3}   % accent2 -- examples, highlights
\definecolor{CERNorange}{HTML}{E15E32} % accent3 -- alerts
\definecolor{CERNgray}{HTML}{BEBECB}   % accent4 -- rules, muted bg
\definecolor{CERNpurple}{HTML}{6E2466} % accent5, hlink
\definecolor{CERNnavy}{HTML}{1C446A}   % accent6 -- deep accent
% Neutrals
\definecolor{CERNtextdark}{HTML}{2F2F2F} % dk2 -- headings in dark variant
\definecolor{CERNbodytext}{HTML}{171717} % tx2*0.5 -- PPTX body text
\definecolor{CERNlightbg}{HTML}{F8F8F8}  % lt2 -- block bg
\definecolor{CERNwhite}{HTML}{FFFFFF}    % lt1

